{
  "name": "snipe-proof-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.0.0",
    "near-api-js": "^7.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
