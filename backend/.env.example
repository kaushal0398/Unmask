# Copy to .env. Development only: nothing here moves real funds.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unmask"
HOST=127.0.0.1
PORT=4001

# Required: the backend refuses to start without an RPC URL (used to check wallet signatures).
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=86400

# Development enclave key seed: 64 hex chars (e.g. `openssl rand -hex 32`).
# Leave unset for a throwaway key; bids sealed before a restart then cannot be opened.
DEV_ENCLAVE_SEED=

# Path to the Rust auction engine (build it with `npm run engine:build`).
AUCTION_ENGINE_BIN=../enclave/auction-engine/target/release/auction-engine

# NEAR Intents 1Click (fund a bid from another chain). Mainnet only, there is no testnet.
# Without a token 1Click charges its default 0.1% fee. Keep the token here, never in the browser.
ONECLICK_API_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=
# Quotes are dry runs (no deposit address) unless this is 1. Only turn it on when you mean to take real deposits.
ONECLICK_ALLOW_LIVE=0

# Optional: run the WASM artifact (the exact bytes that go to OutLayer) under the `wasmtime` CLI instead of the native binary.
# Build it with `sh ../snipe-proof-auction/build.sh`. The published code hash is then the SHA-256 of this .wasm.
# AUCTION_ENGINE_WASM=../snipe-proof-auction/out/auction-engine.wasm

# Run the auction on OutLayer over its HTTPS API instead of locally (needs a payment key: this repo does not have one).
# A run on OutLayer is recorded as mode "outlayer" and labelled "attestation not verified by us" until you verify it
# (see docs/OUTLAYER_ATTESTATION.md). The backend still opens the bids before sending them, so it is NOT private yet.
# AUCTION_ENGINE=outlayer
# OUTLAYER_PROJECT=proofmeme.testnet/snipe-proof-auction
# OUTLAYER_PAYMENT_KEY=owner:nonce:secret        # server-side secret, never in the browser or the repo
# OUTLAYER_CODE_HASH=                            # SHA-256 of the .wasm the version was registered with
# OUTLAYER_API_BASE=https://testnet-api.outlayer.ai
# OUTLAYER_VERSION_KEY=                          # optional: pin one registered version

# Web addresses allowed to call this backend from a browser, comma separated, exact origins only (no wildcard).
# http://localhost:3000 and http://127.0.0.1:3000 are always allowed.
# CORS_ORIGINS=https://your-app.example.com

# Anchor each settlement's commitment on NEAR (optional; off unless all three are set). See docs/FAIRNESS_CERTIFICATE.md.
# The private key is a server-side secret for the writer account only: never commit it, never expose it to the browser.
# ANCHOR_CONTRACT=951abbe83dfc47adeb94652495d612008c215c422cbaa002238449f086eaa755
# ANCHOR_ACCOUNT_ID=cd45f96e0ceaa523cb8038555aef39db40b4deb1b958dc8b352a4cd43da68047
# ANCHOR_PRIVATE_KEY=ed25519:...
